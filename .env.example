# Copy to .env and fill in real values. Never commit .env.

# --- Backend connection (server-only, never exposed to the browser) ---
BACKEND_API_URL=http://localhost:8080

# --- Backend connection (exposed to the browser for public check-in/checkout calls) ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- JWT ---
# MUST be the exact same value as JWT_SECRET in the backend's .env — this frontend
# verifies the JWT issued by the Spring Boot API using this shared secret.
# Use a long, random secret (32+ bytes), e.g.: openssl rand -base64 48
JWT_SECRET=
